
@using CinemaSystem.Models
@model Movie




<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">
            
           
            <div class="col-md-6">
                <img class="card-img-top mb-5 mb-md-0" src="~/images/movie/@Model.MainImg" alt="@Model.Name" />
            </div>
            
         
            <div class="col-md-6">
                <div class="small mb-1">Category: @Model.category?.Name ?? "N/A"</div>
                <div class="small mb-1">Cinema: @Model.cinemas?.Name ?? "N/A"</div>
                <h1 class="display-5 fw-bolder">@Model.Name</h1>

                <p class="lead mb-3">@Model.Description</p>

              
                <p>
                    <strong>Actors:</strong>
                    @if (Model.actors != null && Model.actors.Any())
                    {
                        @foreach (var actor in Model.actors)
                        {
                            <span class="badge bg-secondary me-1">@actor.Name</span>
                        }
                    }
                    else
                    {
                        <span>No actors</span>
                    }
                </p>

                <div class="d-flex">
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.ID" />
                        <input class="form-control text-center me-3" id="inputQuantity" type="number" value="1" style="max-width: 3rem" name="count" />
                        <button class="btn btn-outline-dark flex-shrink-0 mt-3" type="submit">
                            <i class="bi-cart-fill me-1"></i>
                            Add to cart
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</section>
