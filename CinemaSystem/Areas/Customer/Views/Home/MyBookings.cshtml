@model List<CinemaSystem.Areas.Customer.Models.Booking>



<div class="container mt-5">
    <h2 class="mb-4">My Bookings</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No bookings yet.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Customer Name</th>
                    <th>Movie</th>
                    <th>Category</th>
                    <th>Cinema</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Tickets</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.CustomerName</td>
                        <td>@booking.Movie.Name</td>
                        <td>@booking.Movie.category.Name</td>
                        <td>@booking.Movie.cinemas.Name - @booking.Movie.cinemas.Location</td>
                        <td>@booking.Movie.Date.ToString("yyyy-MM-dd")</td>
                        <td>@booking.Movie.Time.ToString()</td>
                        <td>@booking.Tickets</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

