@using CinemaSystem.Models
@model Movie

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <h1>@Model.Name</h1>

        <div class="row mb-4">
            <div class="col-md-6">
                <img class="img-fluid" src="~/images/movie/@Model.MainImg" alt="@Model.Name" />
            </div>
            <div class="col-md-6">
                <p>@Model.Description</p>
                <p><strong>Category:</strong> @Model.category.Name</p>
                <p><strong>Cinema:</strong> @Model.cinemas.Name - @Model.cinemas.Location</p>
                <p><strong>Date:</strong> @Model.Date</p>
                <p><strong>Time:</strong> @Model.Time</p>

                <h5>Actors:</h5>
                <ul>
                    @if (Model.actors !=null && Model.actors.Any())
                       {
                       @foreach (var actor in Model.actors)
                       {
                                <p>@actor.Name</p>
                        }
              }
             else
          {
      <p>No actors available</p>
           }
                </ul>

                <form method="post" asp-action="Book">
                    <input type="hidden" name="id" value="@Model.ID" />
                    <div class="mb-3">
                        <label class="form-label">Customer Name</label>
                        <input type="text" name="customerName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tickets</label>
                        <input type="number" name="tickets" class="form-control" min="1" value="1" required />
                    </div>

                    <div class="card mb-4">
                        <div class="card-body p-4 d-flex flex-row">
                           
                                <div data-mdb-input-init class="form-outline flex-fill">
                                    <input type="text" id="form1" class="form-control form-control-lg" name="code" />
                                    <label class="form-label" for="form1">Discound code</label>
                                </div>
                                <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-outline-warning btn-lg my-3">Apply</button>
                        
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn btn-warning btn-block btn-lg">Proceed to Pay</button>
                        </div>
                    </div>

                    
                    <button type="submit" class="btn btn-primary">Confirm Booking</button>
                </form>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success mt-3">@ViewBag.Message</div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
