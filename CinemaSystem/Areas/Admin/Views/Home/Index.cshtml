@using CinemaSystem.Areas.Admin.Models
@model List<Movie>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin Movies</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="text-center mt-4">
        <a asp-area="Admin" asp-controller="Home" asp-action="DashBoard" href="/Admin/Home/DashBoard" class="btn btn-sm btn-danger">
            DashBoard
        </a>
    </div>
    <div class="container mt-5">
        <h1 class="mb-4">All Movies</h1>

        <div class="row">
            @foreach (var movie in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img class="card-img-top" src="~/images/movie/@movie.MainImg" alt="@movie.Name" style="height: 250px; object-fit: cover;" />
                        <div class="card-body">
                            <h5 class="card-title">@movie.Name</h5>
                            <p class="card-text">@movie.Description</p>
                              <input type="hidden" name="id" value="@movie.ID" />
                            <p><strong>Category:</strong> @movie.category.Name</p>
                            <p><strong>Cinema:</strong> @movie.cinemas.Name</p>
                            <p>
                                <strong>Actors:</strong>
                                @if (movie.actors != null && movie.actors.Any())
                                {
                                    @foreach (var actor in movie.actors)
                                    {
                                        <span class="badge bg-secondary me-1">@actor.Name</span>
                                    }
                                }
                                else
                                {
                                    <span>No actors</span>
                                }
                            </p>
                        </div>
                        <div class="card-footer text-center">
                            <a asp-area="Admin" asp-controller="Home" asp-action="Edit" asp-route-id="@movie.ID" href="/Admin/home/Edit/@movie.ID" class="btn btn-sm btn-warning me-1">Edit</a>
                           
                            <a asp-area="Admin" asp-controller="Home" asp-action="Delete" asp-route-id="@movie.ID" href="/Admin/home/Delete/@movie.ID" class="btn btn-sm btn-danger">Delete</a>
                            <a asp-area="Admin" asp-controller="Home" asp-action="EditCategory" asp-route-id="@movie.ID" href="/Admin/home/EditCategory/@movie.ID" class="btn btn-sm btn-danger">EditCategory</a>
                            <a asp-area="Admin" asp-controller="Home" asp-action="EditCinema" asp-route-id="@movie.ID" href="/Admin/home/EditCinema/@movie.ID" class="btn btn-sm btn-danger">EditCinema</a>
                      
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

